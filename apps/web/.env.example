# Copy to .env.local. NEXT_PUBLIC_ values are public (inlined into the browser bundle); the shop secrets at the end are server-only.

# Canonical site origin, used for metadata, sitemap and share links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# production | staging | development. Only "production" lets search engines index the site.
NEXT_PUBLIC_ENVIRONMENT=development
# Billix API (apps/api). Leave empty to show forms as "opens soon".
NEXT_PUBLIC_API_URL=http://localhost:8000

# Official social profiles. Leave empty until the account exists; empty ones show "Soon".
NEXT_PUBLIC_SOCIAL_YOUTUBE=
NEXT_PUBLIC_SOCIAL_TIKTOK=
NEXT_PUBLIC_SOCIAL_INSTAGRAM=
NEXT_PUBLIC_SOCIAL_FACEBOOK=
NEXT_PUBLIC_SOCIAL_LINKEDIN=
NEXT_PUBLIC_SOCIAL_PINTEREST=
NEXT_PUBLIC_SOCIAL_X=
NEXT_PUBLIC_SOCIAL_THREADS=

# App store listings. Setting either one switches the app pages from waitlist to download links.
NEXT_PUBLIC_APP_STORE_URL=
NEXT_PUBLIC_PLAY_STORE_URL=

# ---- Shop checkout (server-only secrets: never NEXT_PUBLIC_, never committed) ----
# Stripe secret key. Setting it turns checkout on (sk_test_… locally, sk_live_… in production).
STRIPE_SECRET_KEY=
# Signing secret of the Stripe webhook endpoint https://<site>/api/stripe/webhook.
STRIPE_WEBHOOK_SECRET=
# "on" to have Stripe Tax add sales tax (set up Stripe Tax in the dashboard first).
STRIPE_AUTOMATIC_TAX=
# Order emails through Resend: API key and a sender on a domain verified in Resend.
RESEND_API_KEY=
SHOP_EMAIL_FROM=
# Where new-order notes go (defaults to info@billixapp.com).
SHOP_ORDERS_EMAIL=
